# hexagonrpcd with the Redmi Note 10 sensor-PD changes (writable registry, large inputs, idle marker).
# Installed as /usr/bin/hexagonrpcd-mojito next to the stock hexagonrpcd, with its own OpenRC service
# (hexagonrpcd-mojito: secure node, fastrpc user, "served" marker for the sensors and Wi-Fi). Patch details: https://github.com/258ryan/mojito-mainline (mainline/hexagonrpc/).
pkgname=hexagonrpcd-mojito
pkgver=0.4.0
pkgrel=4
pkgdesc="Qualcomm HexagonFS daemon, patched for the Redmi Note 10 sensor PD"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later"
depends="hexagonrpcd"
makedepends="hexagonrpcd linux-headers meson"
subpackages="$pkgname-openrc"
source="
	hexagonrpc-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz
	0001-hexagonrpcd-writable-registry-large-inputs-rename-idle-marker.patch
	hexagonrpcd-mojito.initd
"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	install -Dm755 output/hexagonrpcd/hexagonrpcd "$pkgdir"/usr/bin/hexagonrpcd-mojito
}

openrc() {
	depends="qrtr rmtfs-openrc"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install -Dm755 "$srcdir"/hexagonrpcd-mojito.initd "$subpkgdir"/etc/init.d/hexagonrpcd-mojito
}

sha512sums="
