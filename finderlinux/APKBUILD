# Finder: touch-first Qt 6 / QML shell on KWin in the style of MeeGo Harmattan (private repository 258ryan/finderlinux).
# PRIVATE PACKAGE: built with the MeeGo/Nokia artwork (FINDER_BUNDLE_RESTRICTED_ASSETS); never publish the apk or submit it.
# Source tarball: tools/make-finder-tarballs.sh (git archive of a local clone; the repository is private).
pkgname=finderlinux
pkgver=0_git20261124
_rev=20261124
pkgrel=0
pkgdesc="Finder touch shell (MeeGo Harmattan style) on KWin, with greeter, settings and keyboard"
url="https://github.com/258ryan/finderlinux"
arch="aarch64"
license="custom"
depends="
	kwin
	layer-shell-qt
	qt6-qtdeclarative
	qt6-qtmultimedia
	qt6-qtwayland
	xdg-desktop-portal
	"
makedepends="
	cmake
	kglobalaccel-dev
	layer-shell-qt-dev
	libkscreen-dev
	libxkbcommon-dev
	mesa-dev
	polkit-qt-dev
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtmultimedia-dev
	qt6-qtshadertools-dev
	qt6-qtwayland-dev
	samurai
	taglib-dev
	wayland-dev
	wayland-protocols
	"
install="$pkgname.post-install"
options="!check"
source="$pkgname-$_rev.tar.gz"
builddir="$srcdir/$pkgname-$_rev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DFINDER_BUILD_TESTS=OFF \
		-DFINDER_BUNDLE_RESTRICTED_ASSETS=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
sha512sums="
