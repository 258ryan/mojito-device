# Reference: <https://postmarketos.org/devicepkg>
# Mainline port: https://github.com/258ryan/mojito-mainline
pkgname=device-xiaomi-mojito
pkgdesc="Xiaomi Redmi Note 10 (mainline)"
pkgver=2
pkgrel=1
url="https://github.com/258ryan/mojito-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	firmware-xiaomi-mojito-mainline
	hexagonrpcd-mojito
	linux-postmarketos-qcom-sm6150
	mkbootimg
	postmarketos-base
	qrtr
	rmtfs
	soc-qcom
	soc-qcom-qbootctl
	systemd-boot
"
makedepends="devicepkg-dev"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
subpackages="$pkgname-openrc"
source="
	deviceinfo
	kernel-cmdline.conf
	mojito-wifi.initd
	mojito-sensors.initd
	ath10k-mojito.modprobe.conf
	gmobile-mojito.sh
	display-panel.json
	99-mojito-wallpaper.gschema.override
	ucm-HiFi.conf
	ucm-card.conf
	81-libssc-xiaomi-mojito.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ath10k_snoc and hci_uart are loaded in order by mojito-wifi, not by udev
	install -Dm644 "$srcdir"/ath10k-mojito.modprobe.conf \
		"$pkgdir"/usr/lib/modprobe.d/ath10k-mojito.conf

	# Phosh/phoc display cutout and rounded corners (GLib resource overlay over gmobile's panel data)
	install -Dm644 "$srcdir"/gmobile-mojito.sh \
		"$pkgdir"/etc/profile.d/gmobile-mojito.sh
	install -Dm644 "$srcdir"/display-panel.json \
		"$pkgdir"/usr/share/gmobile-mojito/display-panels/xiaomi,mojito.json

	# WORKAROUND: plain wallpaper; the default JPEG XL one makes glycin exhaust memory into a lock-up
	install -Dm644 "$srcdir"/99-mojito-wallpaper.gschema.override \
		-t "$pkgdir"/usr/share/glib-2.0/schemas

	# accelerometer mount matrix for iio-sensor-proxy/libssc (upright read "bottom-up" without it)
	install -Dm644 "$srcdir"/81-libssc-xiaomi-mojito.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d

	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/mojito/HiFi.conf
	install -Dm644 "$srcdir"/ucm-card.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Redmi Note 10.conf"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install -Dm755 "$srcdir"/mojito-wifi.initd "$subpkgdir"/etc/init.d/mojito-wifi
	install -Dm755 "$srcdir"/mojito-sensors.initd "$subpkgdir"/etc/init.d/mojito-sensors
}

