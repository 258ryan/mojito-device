#!/sbin/openrc-run
# Redmi Note 10 (mojito/sunny): load the WCN3950 drivers in the order its firmware requires.
#
# 1. ath10k_snoc only after the ADSP sensor PD has been served by hexagonrpcd-mojito ($SERVED). The modem's WLAN
#    firmware answers the capability request with error 119 until then (verified on stock Android: only with the
#    sensorspd file server running) and then crashes and restarts; the driver does not retry.
# 2. hci_uart only after wlan0 exists. Bluetooth and WLAN share the WCN3950 PMU rails, and ath10k's power-sequencer
#    vote keeps them up. Before that, Bluetooth's power cycles (probe retries, bluetoothd's power-on) drop the rails
#    after the modem has initialised the chip, and both Bluetooth and WLAN stay dead for the boot.
# Both modules are therefore kept from udev autoload (/usr/lib/modprobe.d/ath10k-mojito.conf).

name="mojito Wi-Fi/Bluetooth"
description="Load ath10k_snoc and hci_uart once the WCN3950 firmware is ready for them"
SERVED=/run/hexagonrpcd-mojito/served

depend() {
	need hexagonrpcd-mojito
}

start() {
	ebegin "Loading Wi-Fi and Bluetooth in the background"
	( for i in $(seq 1 360); do
		[ -e $SERVED ] && break
		sleep 0.5
	  done
	  [ -e $SERVED ] || { logger -t mojito-wifi "sensor PD not served after 180 s, not loading Wi-Fi"; exit 1; }
	  lsmod | grep -q '^ath10k_snoc ' && exit 0
	  before=$(dmesg | grep -c 'capability req rejected')
	  logger -t mojito-wifi "sensor PD served, loading ath10k_snoc"
	  modprobe ath10k_snoc
	  for i in $(seq 1 60); do
		if [ -e /sys/class/net/wlan0 ]; then
			logger -t mojito-wifi "wlan0 up, loading hci_uart"
			modprobe hci_uart
			exit 0
		fi
		if [ "$(dmesg | grep -c 'capability req rejected')" -gt "$before" ]; then
			# leave the firmware alone instead of letting it crash and restart in a loop
			logger -t mojito-wifi "capability rejected (119): unloading ath10k_snoc"
			rmmod ath10k_snoc
			exit 1
		fi
		sleep 0.5
	  done ) >/dev/null 2>&1 &
	eend 0
}

# Nothing to stop: the drivers stay loaded (unloading hci_uart after a failed setup oopses in 7.4,
# qca_serdev_remove -> serdev_device_close on an already closed port).
