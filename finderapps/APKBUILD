# finderapps: the Finder shell's system applications (Files, Music, Clock, Gallery, ...), built on finderlinux's MeeGo QML module
# (private repository 258ryan/finderapps). PRIVATE PACKAGE (N9 artwork): never publish the apk or submit it.
# Source tarball: tools/make-finder-tarballs.sh.
pkgname=finderapps
pkgver=0_git20261124
_rev=20261124
pkgrel=0
pkgdesc="System applications for the Finder shell"
url="https://github.com/258ryan/finderapps"
arch="aarch64"
license="custom"
depends="finderlinux qt6-qtdeclarative qt6-qtmultimedia"
makedepends="
	cmake
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtmultimedia-dev
	qtkeychain-dev
	samurai
	taglib-dev
	"
options="!check"
source="$pkgname-$_rev.tar.gz"
builddir="$srcdir/$pkgname-$_rev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
sha512sums="
